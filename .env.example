# Public base URL of the deployed site (also used for canonical metadata)
NEXT_PUBLIC_SITE_URL=https://ansh-vishwakarma-portfolio-website.vercel.app

# Supabase project URL and server-only service role key.
# Never prefix the service role key with NEXT_PUBLIC_ or expose it to browser code.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
